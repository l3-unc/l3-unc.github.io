---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.sitemap == false or p.layout == nil or p.url contains '.xml' or p.url contains '.txt' -%}{%- continue -%}{%- endif %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
